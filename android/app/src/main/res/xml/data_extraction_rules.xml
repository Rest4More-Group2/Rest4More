<?xml version="1.0" encoding="utf-8"?>
<!-- Geen cloudback-up en geen overdracht naar een ander toestel: de lokale
     database is versleuteld met een sleutel die in de Android Keystore blijft
     en niet meeverhuist. Gegevens komen terug via de eigen synchronisatie. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
